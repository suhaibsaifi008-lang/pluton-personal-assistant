# Copy to .env and add a provider key when you are ready to enable AI chat.
PLUTON_DATABASE_URL=sqlite:///./data/pluton.db
PLUTON_ALLOWED_WORKSPACE=.
PLUTON_AI_PROVIDER=openai
PLUTON_OPENAI_API_KEY=
PLUTON_OPENAI_MODEL=gpt-4.1-mini
PLUTON_OPENAI_BASE_URL=https://api.openai.com/v1
PLUTON_PROVIDER_TIMEOUT_SECONDS=45
PLUTON_LOG_LEVEL=INFO
PLUTON_TERMINAL_TIMEOUT_SECONDS=20
PLUTON_WEB_TIMEOUT_SECONDS=15
PLUTON_MAX_TOOL_OUTPUT_CHARS=8000
PLUTON_MEMORY_CONTEXT_LIMIT=5
